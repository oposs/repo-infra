{
  "assets": {
    "release-pr": {
      "version": 1,
      "source": "workflows/release-pr.yml",
      "target": ".github/workflows/release-pr.yml"
    },
    "changelog": {
      "version": 1,
      "source": "workflows/changelog.yml",
      "target": ".github/workflows/changelog.yml"
    },
    "dependabot": {
      "version": 1,
      "source": "workflows/dependabot.yml",
      "target": ".github/dependabot.yml"
    },
    "workflow-lib": {
      "version": 1,
      "source": "workflows/lib",
      "target": ".github/workflows/lib",
      "kind": "dir",
      "comment": "//"
    }
  },
  "ci_blocks": {
    "ci-lib": {"version": 1, "jobs": ["lib"]},
    "ci-claude-plugin": {"version": 1, "jobs": ["plugin-manifest"]},
    "ci-python": {"version": 1, "jobs": ["ruff", "pytest"]},
    "ci-rust": {"version": 1, "jobs": ["rust-check", "rust-test"]},
    "ci-go": {"version": 1, "jobs": ["go-test", "go-lint"]},
    "ci-node-pnpm": {"version": 1, "jobs": ["node-pnpm-check"]},
    "ci-node-bun": {"version": 1, "jobs": ["node-bun-check"]},
    "ci-perl-autotools": {"version": 2, "jobs": ["perl-autotools"]},
    "ci-perl-mkpl": {"version": 1, "jobs": ["perl-mkpl"]},
    "ci-checkmk-plugin": {"version": 1, "jobs": ["cmk-lint", "cmk-test", "cmk-package"]}
  },
  "publish_blocks": {
    "publish-source-tarball": {"version": 1, "jobs": ["publish-source-tarball"]}
  },
  "build_assets": {
    "container-test": {
      "version": 1,
      "source": "build/container-test.mk",
      "target": "build/container-test.mk",
      "comment": "#"
    }
  },
  "actions": {
    "actions/checkout": "v7",
    "actions/setup-node": "v7",
    "actions/github-script": "v9",
    "actions/setup-python": "v7",
    "actions/cache": "v6",
    "actions/setup-go": "v7",
    "golangci/golangci-lint-action": "v9",
    "oven-sh/setup-bun": "v2",
    "shogo82148/actions-setup-perl": "v1",
    "oposs/mkp-builder": "v2"
  },
  "gh": {
    "ruleset-main": {"version": 1, "source": "gh/ruleset-main.json"}
  }
}
