{
  "ecosystems": [
    {
      "id": "claude-plugin",
      "signals": {"all": [".claude-plugin/plugin.json"]},
      "ci_block": "ci-claude-plugin",
      "version_files": [
        {
          "path": ".claude-plugin/plugin.json",
          "pattern": "\"version\"\\s*:\\s*\"[^\"]*\"",
          "replacement": "\"version\": \"$VERSION\"",
          "verify": "\"version\"\\s*:\\s*\"$VERSION\""
        }
      ]
    },
    {
      "id": "python",
      "signals": {"all": ["pyproject.toml"]},
      "ci_block": "ci-python",
      "version_files": [
        {
          "path": "pyproject.toml",
          "pattern": "^version\\s*=\\s*\"[^\"]*\"",
          "replacement": "version = \"$VERSION\"",
          "verify": "^version\\s*=\\s*\"$VERSION\""
        }
      ]
    },
    {
      "id": "rust",
      "signals": {"all": ["Cargo.toml"]},
      "ci_block": "ci-rust",
      "version_files": [
        {
          "path": "Cargo.toml",
          "pattern": "^version\\s*=\\s*\"[^\"]*\"",
          "replacement": "version = \"$VERSION\"",
          "verify": "^version\\s*=\\s*\"$VERSION\""
        }
      ]
    },
    {
      "id": "go",
      "signals": {"all": ["go.mod"]},
      "ci_block": "ci-go",
      "version_files": []
    },
    {
      "id": "node-pnpm",
      "signals": {"all": ["package.json", "pnpm-lock.yaml"], "none": ["bun.lock", "package-lock.json"]},
      "ci_block": "ci-node-pnpm",
      "version_files": [
        {
          "path": "package.json",
          "pattern": "\"version\"\\s*:\\s*\"[^\"]*\"",
          "replacement": "\"version\": \"$VERSION\"",
          "verify": "\"version\"\\s*:\\s*\"$VERSION\""
        }
      ]
    },
    {
      "id": "node-bun",
      "signals": {"all": ["package.json", "bun.lock"], "none": ["pnpm-lock.yaml", "package-lock.json"]},
      "ci_block": "ci-node-bun",
      "version_files": [
        {
          "path": "package.json",
          "pattern": "\"version\"\\s*:\\s*\"[^\"]*\"",
          "replacement": "\"version\": \"$VERSION\"",
          "verify": "\"version\"\\s*:\\s*\"$VERSION\""
        }
      ]
    },
    {
      "id": "perl-autotools",
      "signals": {"all": ["configure.ac", "cpanfile"]},
      "ci_block": "ci-perl-autotools",
      "version_files": [
        {
          "path": "VERSION",
          "pattern": "^[0-9][^\\n]*$",
          "replacement": "$VERSION",
          "verify": "^$VERSION$"
        }
      ]
    },
    {
      "id": "checkmk-plugin",
      "signals": {"all": [".mkp-builder.ini"]},
      "ci_block": "ci-checkmk-plugin",
      "version_files": []
    },
    {
      "id": "perl-mkpl",
      "signals": {"all": ["Makefile.PL"], "none": ["configure.ac"]},
      "ci_block": "ci-perl-mkpl",
      "version_files": []
    },
    {
      "id": "repo-infra",
      "signals": {"all": ["skills/repo-infra/assets/manifest.json"]},
      "ci_block": "ci-repo-infra-selftest",
      "version_files": []
    }
  ],
  "candidates": [
    {"id": "docs-site", "signals": {"any": ["book.toml"]}},
    {"id": "man-pages", "signals": {"any": ["docs/manual.md"]}}
  ],
  "ambiguities": [
    {
      "id": "node-lockfiles",
      "signals": {"all": ["pnpm-lock.yaml", "package-lock.json"]},
      "question": "This repository has both pnpm-lock.yaml and package-lock.json. Which package manager is authoritative? Installing CI for the wrong one resolves different dependency versions than the developer does.",
      "options": ["pnpm", "npm"]
    },
    {
      "id": "node-pnpm-vs-bun",
      "signals": {"all": ["pnpm-lock.yaml", "bun.lock"]},
      "question": "This repository has both pnpm-lock.yaml and bun.lock. Which package manager is authoritative? Installing CI for the wrong one resolves different dependency versions than the developer does.",
      "options": ["pnpm", "bun"]
    },
    {
      "id": "node-bun-vs-npm",
      "signals": {"all": ["bun.lock", "package-lock.json"]},
      "question": "This repository has both bun.lock and package-lock.json. Which package manager is authoritative? Installing CI for the wrong one resolves different dependency versions than the developer does.",
      "options": ["bun", "npm"]
    }
  ]
}
